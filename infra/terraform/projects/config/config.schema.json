{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorydirector.dev/terraform-config.schema.json",
  "title": "Memory Director Terraform non-sensitive configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "resource_name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "environment": { "type": "string", "enum": ["sandbox"] },
    "default_region": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "allow_destroy": { "type": "boolean" },
    "state_bucket_name": { "type": "string", "minLength": 3 },
    "github_repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "mcp_image": { "type": "string", "minLength": 1 },
    "mcp_secret_project_id": { "type": "string", "minLength": 1 },
    "mcp_invoker_service_account_email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.iam\\.gserviceaccount\\.com$" },
    "mcp_endpoint": { "type": "string", "format": "uri", "pattern": "^https://" },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
